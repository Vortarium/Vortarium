rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Recipes are permanent: anyone logged in can read, create once, never edit/delete.
    match /recipes/{key} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['a', 'b', 'n', 'e', 'by', 'uid', 'created'])
        && request.resource.data.n is string && request.resource.data.n.size() > 0 && request.resource.data.n.size() <= 40
        && request.resource.data.e is string && request.resource.data.e.size() > 0 && request.resource.data.e.size() <= 16;
      allow update, delete: if false;
    }

    // Elements: one permanent record per result that has ever been discovered.
    match /elements/{key} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['n', 'e', 'by', 'uid', 'created'])
        && request.resource.data.n is string && request.resource.data.n.size() > 0 && request.resource.data.n.size() <= 40
        && request.resource.data.e is string && request.resource.data.e.size() > 0 && request.resource.data.e.size() <= 16;
      allow update, delete: if false;
    }

    // Global discovery counter: public read (login page shows it), +1 steps only.
    match /meta/stats {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.total == 1;
      allow update: if request.auth != null
        && request.resource.data.total == resource.data.total + 1;
      allow delete: if false;
    }

    // Saver mode switch: everyone can read it, only the vortarium account can change it.
    match /meta/settings {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && request.auth.token.email == 'vortarium@jewelfish.app'
        && request.resource.data.saver is bool;
      allow delete: if false;
    }

    // Daily challenge boards: one per date, created once by the first player to open it.
    match /daily/{date} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.keys().hasOnly(['date', 'items', 'by', 'uid', 'created'])
        && request.resource.data.date == date
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.items is list
        && request.resource.data.items.size() == 25;
      allow update, delete: if false;
    }

    // Queue: a waiting player. Only you write your own doc (join / heartbeat / leave);
    // anyone can set matchId once, to pair two waiting players.
    match /queue/{uid} {
      allow read: if request.auth != null;
      allow create: if request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['uid', 'username', 'created', 'seen', 'matchId'])
        && request.resource.data.matchId == null;
      allow update: if request.auth != null && (
        (request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['seen']))
        || (resource.data.matchId == null
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['matchId'])
          && request.resource.data.matchId is string));
      allow delete: if request.auth.uid == uid;
    }

    // Queue matches: lobby (mode vote, AI words or custom tiles) then the live game. Only the two players can see or touch them.
    // There is no inactivity timeout: players can think as long as they like.
    match /matches/{id} {
      allow read: if request.auth != null && request.auth.uid in resource.data.players;
      allow create: if request.auth != null
        && request.auth.uid in request.resource.data.players
        && request.resource.data.players.size() == 2
        && request.resource.data.phase == 'pick'
        && request.resource.data.status == 'active';
      allow update: if request.auth != null && request.auth.uid in resource.data.players
        && resource.data.status == 'active' && (
        // lobby: mode votes, AI words / custom tiles (proposal, accept, veto), ready, shuffled items. Locked once the game starts.
        (resource.data.phase != 'play'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['votes', 'mode', 'phase', 'tiles', 'proposal', 'turn', 'ready', 'items']))
        // ask to end / cancel the request (only your own entry changes)
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['endReq'])
          && request.resource.data.endReq.toSet().difference(resource.data.endReq.toSet()).hasOnly([request.auth.uid].toSet())
          && resource.data.endReq.toSet().difference(request.resource.data.endReq.toSet()).hasOnly([request.auth.uid].toSet())
          && request.resource.data.endReq.toSet().hasOnly(resource.data.players.toSet()))
        // finish (full board / both agreed), forfeit yourself, or cancel before the game starts
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'loser'])
          && (request.resource.data.status == 'done'
            || (request.resource.data.status == 'forfeit' && request.resource.data.loser == request.auth.uid)
            || (request.resource.data.status == 'cancelled' && resource.data.phase != 'play'))));
      allow delete: if false;

      // one doc per claimed tile (id = tile number 0-24). Create-only, so the first claim wins. Only while the game is live.
      match /claims/{idx} {
        allow read: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/matches/$(id)).data.players;
        allow create: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/matches/$(id)).data.players
          && get(/databases/$(database)/documents/matches/$(id)).data.status == 'active'
          && get(/databases/$(database)/documents/matches/$(id)).data.phase == 'play'
          && idx.matches('^([0-9]|1[0-9]|2[0-4])$')
          && request.resource.data.keys().hasOnly(['uid', 'idx'])
          && request.resource.data.uid == request.auth.uid;
        allow update, delete: if false;
      }
    }

    // Players: everyone logged in can read (leaderboard), only you can write your own.
    match /users/{uid} {
      allow read: if request.auth != null;
      allow create: if request.auth.uid == uid
        && request.resource.data.discoveries == 0;
      allow update: if request.auth.uid == uid
        && request.resource.data.username == resource.data.username
        && request.resource.data.discoveries >= resource.data.discoveries
        && request.resource.data.discoveries <= resource.data.discoveries + 1
        // daily score: can only go up, max 152 pts per day (25 items + 102 bingo + 25 clear),
        // and only when moving to a later date, so a day can't be banked twice
        && request.resource.data.get('dailyScore', 0) >= resource.data.get('dailyScore', 0)
        && request.resource.data.get('dailyScore', 0) <= resource.data.get('dailyScore', 0) + 152
        // queue score: can only go up, max 152 pts (same as a full daily) per match
        && request.resource.data.get('queueScore', 0) >= resource.data.get('queueScore', 0)
        && request.resource.data.get('queueScore', 0) <= resource.data.get('queueScore', 0) + 152
        && (request.resource.data.get('lastDailyDate', '') == resource.data.get('lastDailyDate', '')
            || (request.resource.data.lastDailyDate is string
                && request.resource.data.lastDailyDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
                && request.resource.data.lastDailyDate > resource.data.get('lastDailyDate', '')))
        && (request.resource.data.get('dailyScore', 0) == resource.data.get('dailyScore', 0)
            || request.resource.data.get('lastDailyDate', '') != resource.data.get('lastDailyDate', ''));
      allow delete: if false;
    }
  }
}
