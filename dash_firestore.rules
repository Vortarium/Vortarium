rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // The mod account is the one signed up as "vortarium" (email vortarium@dash.game).
    // Sign up that username yourself first so nobody else can claim it.
    function isMod() { return request.auth != null && request.auth.token.email == 'vortarium@dash.game'; }
    function isUser(id) { return request.auth != null && request.auth.uid == id; }
    function only(keys) { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys); }

    match /users/{id} {
      allow read: if true;
      allow create: if isUser(id);
      // owner syncs stats; signed-in players can add likes/views to a creator; the mod can add a verified (rated) count
      allow update: if isUser(id) || (request.auth != null && (only(['likes']) || only(['views']))) || (isMod() && only(['rated']));
      allow delete: if isMod();
    }

    // level slots in the editor, private to their owner (ids look like <uid>_<slot>)
    match /drafts/{id} {
      allow read, write: if request.auth != null && id.matches(request.auth.uid + '_[0-9]+');
    }

    match /levels/{id} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.aid == request.auth.uid && request.resource.data.rating == 0;
      // anyone (even anonymous) adds a view, signed-in players change likes, only the mod can rate
      allow update: if isMod() || only(['views']) || (request.auth != null && only(['likes']));
      allow delete: if isMod() || isUser(resource.data.aid);

      match /votes/{voter} {
        allow read, write: if isUser(voter);
      }
      match /comments/{cid} {
        allow read: if true;
        allow create: if isUser(request.resource.data.uid) && request.resource.data.text.size() <= 200;
        allow delete: if isMod() || isUser(resource.data.uid);
      }
    }

    match /bans/{id} {
      allow read: if request.auth != null;
      allow write: if isMod();
    }
    // friend requests: the document id is the two uids sorted and joined with "_"
    match /requests/{pairId} {
      allow read, delete: if request.auth != null && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
      allow create: if request.auth != null && request.resource.data.from == request.auth.uid && pairId.split('_').hasAny([request.auth.uid]) && request.resource.data.status == 'pending';
      allow update: if request.auth != null && resource.data.to == request.auth.uid && request.resource.data.status == 'accepted' && only(['status']);
    }

    // direct messages, only between accepted friends
    match /dms/{pairId}/msgs/{m} {
      allow read, delete: if request.auth != null && pairId.split('_').hasAny([request.auth.uid]) && get(/databases/$(database)/documents/requests/$(pairId)).data.status == 'accepted';
      allow create: if request.auth != null && request.resource.data.from == request.auth.uid && pairId.split('_').hasAny([request.auth.uid]) && get(/databases/$(database)/documents/requests/$(pairId)).data.status == 'accepted';
    }
  }
}
