rules_version = '2';
// DASH starter rules. Paste into Firebase Console > Firestore > Rules.
// NOTE: this is client-trusting (stats are written by the client), fine for a hobby game; move stat writes
// to Cloud Functions if you ever need cheat-proofing.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function uname() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.username; }
    function isMod() { return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && uname() == 'Vortarium'; }
    function votePath(id) { return /databases/$(database)/documents/levels/$(id)/votes/$(request.auth.uid); }
    function vOld(id) { return exists(votePath(id)) ? get(votePath(id)).data.v : 0; }
    function vNew(id) { return existsAfter(votePath(id)) ? getAfter(votePath(id)).data.v : 0; }
    // likes/dislikes may only change by exactly what this account's own vote doc changed by (written in the same batch/transaction)
    function voteDeltaOk(id) {
      return request.resource.data.likes - resource.data.likes == (vNew(id) == 1 ? 1 : 0) - (vOld(id) == 1 ? 1 : 0)
        && request.resource.data.dislikes - resource.data.dislikes == (vNew(id) == -1 ? 1 : 0) - (vOld(id) == -1 ? 1 : 0);
    }
    function only(keys) { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys); }

    match /usernames/{n} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid && n == n.lower();
      allow delete: if isMod();
    }

    match /users/{uid} {
      allow read: if true;
      allow create: if signedIn() && request.auth.uid == uid;
      allow update: if (signedIn() && request.auth.uid == uid)
        || (signedIn() && only(['netLikes']) && math.abs(request.resource.data.netLikes - resource.data.netLikes) <= 2)
        || isMod();
      allow delete: if isMod();
      match /{sub}/{id} {
        allow read, write: if signedIn() && (request.auth.uid == uid || isMod());
      }
    }

    match /levels/{id} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.authorId == request.auth.uid && request.resource.data.status == 'unrated'
        && request.resource.data.data is string && request.resource.data.data.size() < 900000
        && request.resource.data.title is string && request.resource.data.title.size() <= 18
        && (!('desc' in request.resource.data) || request.resource.data.desc.size() <= 200)
        && request.resource.data.likes == 0 && request.resource.data.dislikes == 0 && request.resource.data.views == 0;
      allow update: if isMod()
        || (only(['views']) && request.resource.data.views == resource.data.views + 1)
        || (signedIn() && only(['likes', 'dislikes']) && voteDeltaOk(id));
      allow delete: if isMod() || (signedIn() && resource.data.authorId == request.auth.uid);
      match /comments/{cid} {
        allow read: if true;
        allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
        allow delete: if isMod() || (signedIn() && (resource.data.uid == request.auth.uid
          || get(/databases/$(database)/documents/levels/$(id)).data.authorId == request.auth.uid));
      }
      match /songChunks/{cid} {
        allow read: if true;
        allow create: if signedIn() && request.resource.data.d.size() < 900000
          && get(/databases/$(database)/documents/levels/$(id)).data.authorId == request.auth.uid;
        allow delete: if isMod() || (signedIn() && get(/databases/$(database)/documents/levels/$(id)).data.authorId == request.auth.uid);
      }
      match /votes/{vid} {
        allow read: if signedIn() && (vid == request.auth.uid || isMod());
        // one vote doc per account; value must be -1/0/1 and can only be changed every 2+ seconds
        allow create: if signedIn() && vid == request.auth.uid && request.resource.data.keys().hasOnly(['v', 't'])
          && request.resource.data.v in [-1, 0, 1] && request.resource.data.t == request.time;
        allow update: if signedIn() && vid == request.auth.uid && request.resource.data.keys().hasOnly(['v', 't'])
          && request.resource.data.v in [-1, 0, 1] && request.resource.data.t == request.time
          && (!('t' in resource.data) || request.time > resource.data.t + duration.value(2, 's'));
        allow delete: if isMod() || (signedIn() && get(/databases/$(database)/documents/levels/$(id)).data.authorId == request.auth.uid);
      }
    }

    match /friendRequests/{rid} {
      allow read: if signedIn() && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
      allow create: if signedIn() && request.resource.data.from == request.auth.uid;
      allow update: if signedIn() && resource.data.to == request.auth.uid;
      allow delete: if signedIn() && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
    }

    match /friends/{uid}/list/{fid} {
      allow read: if signedIn() && (request.auth.uid == uid || isMod());
      allow write: if signedIn() && (request.auth.uid == uid || isMod()
        || (exists(/databases/$(database)/documents/friendRequests/$(uid + '_' + fid))
            && get(/databases/$(database)/documents/friendRequests/$(uid + '_' + fid)).data.status == 'accepted'
            && request.auth.uid == fid));
    }

    match /dms/{pair}/messages/{mid} {
      allow read, delete: if signedIn() && request.auth.uid in pair.split('_');
      allow create: if signedIn() && request.auth.uid in pair.split('_') && request.resource.data.from == request.auth.uid;
    }

    match /banned/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isMod());
      allow write: if isMod();
    }
  }
}

// Level songs are now stored in Firestore (levels/{id}/songChunks), so no Firebase Storage setup is needed.
