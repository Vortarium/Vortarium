rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // the Vortarium account is the moderator (can edit/take down any song)
    function isMod() {
      return request.auth != null && request.auth.token.email == 'vortarium@spotify-clone.app';
    }

    // profiles, likes and playlists all live under the user's own account
    match /users/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;

      match /likes/{songId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      // who this user follows (private)
      match /following/{otherId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      // people following this user; each follower manages their own entry
      match /followers/{followerId} {
        allow read: if request.auth != null;
        allow create, update, delete: if request.auth != null && request.auth.uid == followerId && followerId != uid;
      }

      // notifications (follows and shared playlists): the sender creates them, the owner reads/clears them
      match /notifications/{notifId} {
        allow read, update: if request.auth != null && request.auth.uid == uid;
        allow create: if request.auth != null
                      && request.resource.data.fromUid == request.auth.uid
                      && request.auth.uid != uid
                      && (notifId == request.auth.uid || notifId.matches(request.auth.uid + '_.*'));
        allow delete: if request.auth != null && (request.auth.uid == uid || request.auth.uid == resource.data.fromUid);
      }

      // private by default: only the owner can read their own playlists here
      match /playlists/{playlistId} {
        allow read, create, update, delete: if request.auth != null && (request.auth.uid == uid || isMod());
      }
    }

    // copies of playlists the owner has made public (anyone signed in can open them)
    match /public_playlists/{playlistId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.ownerId;
      // owner can edit anything; people the playlist is shared with may only change songIds (adding songs)
      allow update: if request.auth != null
                    && (request.auth.uid == request.resource.data.ownerId
                        || (request.auth.uid in resource.data.get('sharedWith', [])
                            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['songIds'])));
      allow delete: if request.auth != null && request.auth.uid == resource.data.ownerId;
    }

    // playlists the owner shared with specific followers (listed in sharedWith).
    // Collaborative: everyone in sharedWith can add songs; this doc is the source of truth.
    match /shared_playlists/{playlistId} {
      allow read: if request.auth != null
                  && (request.auth.uid == resource.data.ownerId || request.auth.uid in resource.data.sharedWith);
      allow create: if request.auth != null && request.auth.uid == request.resource.data.ownerId;
      allow update: if request.auth != null
                    && (request.auth.uid == resource.data.ownerId
                        || (request.auth.uid in resource.data.sharedWith
                            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['songIds'])));
      allow delete: if request.auth != null && request.auth.uid == resource.data.ownerId;
    }

    // lyrics found online, saved once per song. Anyone signed in can save lyrics for a song that has none yet;
    // only the Vortarium moderator or the song's owner can replace or delete them.
    match /lyrics/{songId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.keys().hasOnly(['status', 'synced', 'plain', 'source', 'by', 'at'])
                    && request.resource.data.by == request.auth.uid
                    && request.resource.data.synced.size() < 300000
                    && request.resource.data.plain.size() < 300000;
      allow update, delete: if isMod()
                            || (request.auth != null
                                && exists(/databases/$(database)/documents/songs/$(songId))
                                && get(/databases/$(database)/documents/songs/$(songId)).data.ownerId == request.auth.uid);
    }

    match /songs/{songId} {
      allow read: if request.auth != null;
      // the moderator may upload on behalf of another user (ownerId is that user)
      allow create: if request.auth != null
                    && (request.auth.uid == request.resource.data.ownerId || isMod())
                    && request.resource.data.uuid == songId;
      // owners can edit anything; everyone else may only add exactly +1 to the view counter
      allow update: if request.auth != null
                    && (request.auth.uid == resource.data.ownerId
                        || isMod()
                        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views'])
                            && request.resource.data.views == resource.data.get('views', 0) + 1)
                        // anyone can switch explicit ON (done automatically when lyrics contain bad words), never off
                        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['explicit'])
                            && request.resource.data.explicit == true));
      allow delete: if request.auth != null && (request.auth.uid == resource.data.ownerId || isMod());

      match /chunks/{chunkId} {
        allow read: if request.auth != null;
        allow create, update: if request.auth != null
                              && (request.auth.uid == get(/databases/$(database)/documents/songs/$(songId)).data.ownerId || isMod())
                              && request.resource.data.data.size() < 950000;
        allow delete: if request.auth != null
                      && (request.auth.uid == get(/databases/$(database)/documents/songs/$(songId)).data.ownerId || isMod());
      }
    }
  }
}
