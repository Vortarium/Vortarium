rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Player profiles + leaderboard (everyone signed in can read, you can only write your own)
    match /numerus_users/{uid} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.auth.uid == uid;

      // Numeron's shared stats (all players combined): anyone can add to them, but they can only go up
      allow create: if signedIn() && uid == 'numeron';
      allow update: if signedIn() && uid == 'numeron'
        && request.resource.data.points >= resource.data.points
        && request.resource.data.wins >= resource.data.wins
        && request.resource.data.games >= resource.data.games;

      allow delete: if false;
    }

    // Matchmaking queue (players also update each other's entry when pairing up)
    match /numerus_queue/{uid} {
      allow read, create, update, delete: if signedIn();
    }

    // Live matches (questions + each player's answers)
    match /numerus_matches/{matchId} {
      allow read, create, update: if signedIn();
      allow delete: if false;
    }

    // Daily challenge: today's shared questions (first player of the day creates them, nobody can edit)
    match /numerus_daily/{day} {
      allow read, create: if signedIn();
      allow update, delete: if false;
    }

    // One doc per player per day (id = date_uid). Created when the daily starts, filled in once when it ends.
    match /numerus_dailyscores/{id} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && id == request.resource.data.day + '_' + request.auth.uid
        && request.resource.data.score == null;
      allow update: if signedIn()
        && resource.data.uid == request.auth.uid
        && resource.data.score == null
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.score is number;
      allow delete: if false;
    }

    // The all-time bell curve (count, sum and sum of squares of every game score: dailies, bot, human and room/team games, one entry per player per game)
    match /numerus_daily_stats/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && id == 'global' && request.resource.data.n == 1;
      allow update: if signedIn() && id == 'global'
        && request.resource.data.n == resource.data.n + 1
        && request.resource.data.sum >= resource.data.sum
        && request.resource.data.sumsq >= resource.data.sumsq
        && request.resource.data.sum - resource.data.sum <= 1000
        && request.resource.data.sumsq - resource.data.sumsq <= 1000000;
      allow delete: if false;
    }

    // Question bank: every generated question is logged here once (doc id = hash of the text, so exact repeats are refused).
    // Anyone signed in can log AI questions; only vortarium can add its own and fix missing units.
    match /numerus_questions/{id} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.q is string
        && request.resource.data.a is number
        && request.resource.data.source in ['ai', 'seed', 'vortarium']
        && (request.resource.data.source != 'vortarium' || request.auth.token.email == 'vortarium@numerus.app');
      // Unit audit: only vortarium, only the unit field, and only to fill a blank (or placeholder) unit.
      allow update: if signedIn()
        && request.auth.token.email == 'vortarium@numerus.app'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['unit'])
        && request.resource.data.unit is string
        && request.resource.data.unit.size() > 0
        && request.resource.data.unit.size() <= 40
        && (!('unit' in resource.data)
            || resource.data.unit == ''
            || resource.data.unit.lower().matches('(n/?a|none|null|units?|numbers?|count|value|[?.-]+)'));
      // 12-hour lock: any signed-in player can lock a question they just used (unlockAt = ms time it becomes valid again), nothing else.
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['unlockAt'])
        && request.resource.data.unlockAt is number
        && request.resource.data.unlockAt <= request.time.toMillis() + 43260000;
      allow delete: if false;
    }

    // Which bank questions each player has already been served (one doc per player, ids only)
    match /numerus_seen/{uid} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.auth.uid == uid;
      allow delete: if false;
    }

    // Custom rooms (8-digit code = doc id). Lobby, ready states, questions and each player's answers live here.
    match /numerus_rooms/{code} {
      allow read, update, delete: if signedIn();
      allow create: if signedIn() && code.matches('[0-9]{8}');
    }

    // Everything else stays locked
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
