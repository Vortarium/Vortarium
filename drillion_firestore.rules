rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function d() { return request.resource.data; }
    function playPath(uid, key) {
      return /databases/$(database)/documents/users/$(uid)/plays/$(key);
    }

    // Player profiles + leaderboard source
    match /users/{uid} {
      allow read: if signedIn();
      allow create: if request.auth.uid == uid
        && d().keys().hasOnly(['username','depth','score','played','best','at'])
        && d().username is string && d().username.matches('^[A-Za-z0-9_]{3,16}$')
        && d().depth == 0 && d().score == 0 && d().played == 0;
      // one dig at a time: depth/score only go up by at most one dig's worth
      allow update: if request.auth.uid == uid
        && d().diff(resource.data).affectedKeys().hasOnly(['depth','score','played','best'])
        && d().depth - resource.data.depth >= 0 && d().depth - resource.data.depth <= 10500
        && d().score - resource.data.score >= 0 && d().score - resource.data.score <= 840
        && d().played == resource.data.played + 1
        && (!('best' in d().keys()) || (d().best <= 840 && d().best >= resource.data.get('best', 0)));

      // Questions this account has already played (so they are not served again)
      match /seen/{qid} {
        allow read: if request.auth.uid == uid;
        allow create: if request.auth.uid == uid && qid.matches('^[a-z0-9]{3,20}$');
      }

      // Which questions this account has answered (one play per key)
      match /plays/{key} {
        allow read: if request.auth.uid == uid;
        allow create: if request.auth.uid == uid
          && key.matches('^[A-Z]{4}$')
          && d().tiers is list && d().tiers.size() == 7
          && d().pts is int && d().pts >= 0 && d().pts <= 840;
      }
    }

    // Shared question bank (each question stored once)
    match /bank/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && id.matches('^[a-z0-9]{3,20}$')
        && d().keys().hasOnly(['q','r','by','at'])
        && d().q is string && d().q.size() <= 90;
      allow delete: if signedIn();
    }

    // Generated questions, keyed by 4 letters, with bell-curve counters
    match /questions/{key} {
      allow read: if signedIn();
      allow create: if signedIn()
        && key.matches('^[A-Z]{4}$')
        && d().keys().hasOnly(['qs','by','r','at','n','sum','c0','c1','c2','c3','c4','c5','cm'])
        && d().by == request.auth.uid
        && d().qs is list && d().qs.size() == 7
        && d().n == 0 && d().sum == 0;
      // counters may only move when this user's play doc is created in the same batch
      allow update: if signedIn()
        && d().diff(resource.data).affectedKeys().hasOnly(['n','sum','c0','c1','c2','c3','c4','c5','cm'])
        && d().n == resource.data.n + 1
        && d().sum >= resource.data.sum && d().sum - resource.data.sum <= 840
        && !exists(playPath(request.auth.uid, key))
        && existsAfter(playPath(request.auth.uid, key));

      // Shared grading cache so every player gets the same tier for the same answer
      match /answers/{a} {
        allow read: if signedIn();
        allow create: if signedIn()
          && a.matches('^[0-6]_[a-z0-9]{1,60}$')
          && d().keys().hasOnly(['tier','why'])
          && d().tier is int && d().tier >= -1 && d().tier <= 5
          && d().why is string && d().why.size() <= 60;
      }
    }

    // Global distribution of total scores (21 buckets of 40 points)
    match /stats/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && id == 'scores' && d().n == 1;
      allow update: if signedIn() && id == 'scores'
        && d().diff(resource.data).affectedKeys().hasOnly(['n','b0','b1','b2','b3','b4','b5','b6','b7','b8','b9','b10','b11','b12','b13','b14','b15','b16','b17','b18','b19','b20'])
        && d().n == resource.data.n + 1;
    }

    // Question of the day: first player of the (UTC) day creates it
    match /daily/{date} {
      allow read: if signedIn();
      allow create: if signedIn()
        && date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d().keys().hasOnly(['key'])
        && d().key.matches('^[A-Z]{4}$')
        && exists(/databases/$(database)/documents/questions/$(d().key));
    }
  }
}
