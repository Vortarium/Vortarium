rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() { return request.auth != null; }
    function isOwner(uid) { return isSignedIn() && request.auth.uid == uid; }

    // Server-side admin/mod list. This is enforced here, not in client JS,
    // so it cannot be bypassed by editing the page. Replace the UID below
    // with Vortarium's actual Firebase Auth UID (Firebase Console >
    // Authentication, or console.log(auth.currentUser.uid) once logged in).
    // The admin is whoever owns the reserved username "vortarium". The
    // /usernames/vortarium doc is created once at signup with that account's
    // real uid and can never be updated afterwards (see below), so the rules
    // look the uid up from there instead of needing a hardcoded UID.
    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/usernames/vortarium)
        && get(/databases/$(database)/documents/usernames/vortarium).data.uid == request.auth.uid;
    }

    // Mutes: a mod sets players/{uid}.mutedUntil (ms since epoch). While it is in
    // the future the player may not post chat, list auction items, pay anyone or
    // send friend requests. Enforced here so a modified client can't skip it.
    function notMuted() {
      return isSignedIn()
        && get(/databases/$(database)/documents/players/$(request.auth.uid)).data.get('mutedUntil', 0) <= request.time.toMillis();
    }

    // Reserved usernames: only the owning account may create/read its own
    // claim; nobody may overwrite someone else's.
    match /usernames/{uname} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.uid == request.auth.uid; // account deletion frees the name
      allow update: if false;
    }

    // Players: public read (leaderboards/profiles), self-only write.
    // No other player's document can EVER be updated by this ruleset —
    // notifications (friend requests, auction sold, friend accept) are
    // therefore delivered via each player's own /inbox subcollection, and
    // the receiving player's OWN client applies the effect to their OWN
    // document. This is enforced here, not just by convention in the app.
    //
    // Money/XP/level/inventory are still writable by the owning client
    // directly (e.g. after winning a battle, buying a shop item). Rules
    // alone cannot verify those values are "earned" rather than invented
    // by a modified client — that requires moving reward-granting into
    // Cloud Functions with the Admin SDK. See the accompanying notes for
    // exactly which operations that applies to.
    match /players/{uid} {
      allow read: if true;
      allow create: if isOwner(uid);
      // Admin may also update another player's doc — used only for banning
      // (setting banned:true and scrubbing displayName to banneduser_#####).
      // A player can never edit their own ban / mute flags — only the admin can.
      // The admin also uses this to strip a banned user out of everyone's friends list.
      allow update: if isAdmin()
        || (isOwner(uid) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['banned','mutedUntil']));
      allow delete: if isOwner(uid) || isAdmin(); // player-initiated or admin ban deletion

      match /quests/{questId} {
        allow read, write: if isOwner(uid);
      }
      // farm plots (players/{uid}/farm/plots) — private to the owner
      match /farm/{docId} {
        allow read, write: if isOwner(uid);
      }
      match /inbox/{notifId} {
        allow update: if isOwner(uid);
        // The admin may read/delete inbox entries only so a ban can clear the
        // banned user's pending friend requests out of other players' inboxes.
        allow read, delete: if isOwner(uid) || isAdmin();
        // any signed-in player may notify another (friend requests,
        // friend-accept, auction-sold receipts) — but only the recipient
        // may read, update or delete their own inbox entries.
        // Payments and friend requests are blocked while the sender is muted.
        allow create: if isSignedIn()
          && (!(request.resource.data.get('type', '') in ['payment_received', 'friend_request']) || notMuted());
      }
      }

    // World boss: one shared doc. Anyone signed in may create it at full HP,
    // only lower its hp (at most 100000 per write), or reset it once it is 0.
    match /boss/{id} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.hp == 1000000000 && request.resource.data.hpMax == 1000000000;
      allow update: if isSignedIn() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hp']) && (
        (request.resource.data.hp >= 0 && request.resource.data.hp < resource.data.hp && resource.data.hp - request.resource.data.hp <= 100000) ||
        (resource.data.hp <= 0 && request.resource.data.hp == 1000000000)
      );
    }

    // Emoji reactions shown above the dragon; sender may delete their own.
    match /reactions/{rid} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid && request.resource.data.emoji in ['❤️','⚔️','🔥','😭'];
      allow delete: if isSignedIn() && (isOwner(resource.data.uid) || isAdmin());
      allow update: if false;
    }

    match /globalChat/{msgId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && notMuted() && request.resource.data.uid == request.auth.uid;
      // A user may delete their own message; the admin may delete anyone's.
      allow delete: if isSignedIn() && (isOwner(resource.data.uid) || isAdmin());
      allow update: if false;
    }

    match /privateChats/{threadId}/messages/{msgId} {
      // threadId is "{uidA}_{uidB}" sorted — only the two participants may
      // read or write into it. Read and create are split: on a read there
      // is no request.resource, so a combined condition that references it
      // rejects every read (this was the permission-denied bug).
      allow read: if isSignedIn() && threadId.split('_').hasAny([request.auth.uid]);
      allow create: if isSignedIn() && notMuted() &&
        threadId.split('_').hasAny([request.auth.uid]) &&
        request.resource.data.uid == request.auth.uid;
      // Sender may delete their own message; the admin may delete anyone's in ANY
      // thread (needed to wipe a banned user's private messages).
      allow delete: if isSignedIn() &&
        ((threadId.split('_').hasAny([request.auth.uid]) && isOwner(resource.data.uid)) || isAdmin());
      allow update: if false;
    }

    // Admin-only collection-group read of every "messages" collection. The ban
    // cleanup uses collectionGroup("messages").where("uid","==",bannedUid) to find
    // the banned user's private messages across all threads. That query also needs
    // a collection-group single-field index on messages.uid (Firestore console >
    // Indexes > Single field > Add exemption: collection ID "messages", field "uid",
    // enable Collection group scope) — the first failed attempt logs a link that
    // creates it for you.
    match /{path=**}/messages/{msgId} {
      allow read: if isAdmin();
    }

    // Live "typing" / "watching" status for a DM thread. Each participant owns
    // exactly one doc (named after their uid) and may only write their own;
    // both participants may read both.
    match /privateChats/{threadId}/presence/{uid} {
      allow read: if isSignedIn() && threadId.split('_').hasAny([request.auth.uid]);
      allow write: if isOwner(uid) && threadId.split('_').hasAny([request.auth.uid]);
    }

    // Auction: sellers may create/cancel(delete) their own listings.
    // A "purchase" is an UPDATE (status -> "sold"), never a delete by a
    // non-owner, so a listing can't just be wiped by anyone without
    // paying. This still trusts the buyer's own client to have actually
    // debited itself the correct amount in the same transaction — see the
    // remaining-limitations note for why only a Cloud Function closes
    // that gap completely.
    match /auction/{listingId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && notMuted()
        && request.resource.data.sellerUid == request.auth.uid
        && request.resource.data.status == "active";
      // Seller cancels their own listing; the admin may remove any listing
      // (mod "Remove Item" and banning a seller).
      allow delete: if isSignedIn() && (isOwner(resource.data.sellerUid) || isAdmin());
      allow update: if isSignedIn() && (
        // seller may edit their own still-active listing
        isOwner(resource.data.sellerUid) ||
        // OR a non-owner may claim an active listing as sold, touching
        // only the sale-related fields
        (
          resource.data.status == "active" &&
          request.resource.data.status == "sold" &&
          request.resource.data.buyerUid == request.auth.uid &&
          request.resource.data.sellerUid == resource.data.sellerUid &&
          request.resource.data.itemId == resource.data.itemId &&
          request.resource.data.qty == resource.data.qty &&
          request.resource.data.pricePer == resource.data.pricePer
        )
      );
    }

    // Duel rooms: only the host may modify host-owned fields; only an
    // unclaimed room (guestUid == null) may be joined, and only by the
    // joining player setting themselves as guest.
    match /duelRooms/{code} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.hostUid == request.auth.uid;
      allow update: if isSignedIn() && (
        isOwner(resource.data.hostUid) ||
        isOwner(resource.data.guestUid) ||
        (
          resource.data.guestUid == null &&
          request.resource.data.guestUid == request.auth.uid &&
          request.resource.data.hostUid == resource.data.hostUid
        )
      );
      allow delete: if isSignedIn() && (isOwner(resource.data.hostUid) || isAdmin());
    }

    match /queue/{uid} {
      allow read: if isSignedIn();
      allow write: if isOwner(uid) || (isAdmin() && request.method == 'delete');
    }
  }
}
