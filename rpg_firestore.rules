rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() { return request.auth != null; }
    function isOwner(uid) { return isSignedIn() && request.auth.uid == uid; }

    // Reserved usernames: only the owning account may create/read its own
    // claim; nobody may overwrite someone else's.
    match /usernames/{uname} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    // Players: public read (leaderboards/profiles), self-only write.
    // Money/inventory/stats can ONLY be changed by the owning client here —
    // for a production game, move reward-granting (battle winnings, auction
    // payouts, level-ups) into Cloud Functions with the Admin SDK so a
    // modified client can't just write itself infinite money. This ruleset
    // is the safe baseline: nobody can touch another player's document.
    match /players/{uid} {
      allow read: if true;
      allow create: if isOwner(uid);
      allow update: if isOwner(uid);
      allow delete: if false;

      match /quests/{questId} {
        allow read, write: if isOwner(uid);
      }
      match /inbox/{notifId} {
        allow read, delete, update: if isOwner(uid);
        // any signed-in player may notify another (friend requests, auction
        // sold notices) but only the recipient may read/manage their inbox
        allow create: if isSignedIn();
      }
    }

    match /globalChat/{msgId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    match /privateChats/{threadId}/messages/{msgId} {
      // threadId is "{uidA}_{uidB}" sorted — only the two participants may
      // read or write into it.
      allow read, create: if isSignedIn() &&
        threadId.split('_').hasAny([request.auth.uid]) &&
        request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    match /auction/{listingId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.sellerUid == request.auth.uid;
      // deletion happens on purchase (by buyer, via transaction) or on
      // cancel (by seller) — both are legitimate from the client with this
      // ruleset; move to a Cloud Function if you want server-verified gold
      // transfer on purchase instead of trusting the buyer's client.
      allow delete: if isSignedIn();
      allow update: if false;
    }

    match /duelRooms/{code} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.hostUid == request.auth.uid;
      allow update: if isSignedIn();
      allow delete: if isSignedIn();
    }

    match /queue/{uid} {
      allow read: if isSignedIn();
      allow write: if isOwner(uid);
    }
  }
}
