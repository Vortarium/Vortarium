rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }

    // Private cloud save: only the owner can read or write it.
    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && request.resource.data.save is string
        && request.resource.data.save.size() < 900000
        && request.resource.data.nickname is string
        && request.resource.data.nickname.size() >= 1
        && request.resource.data.nickname.size() <= 16;
      allow delete: if isOwner(uid);
    }

    // Public profile used by leaderboards (readable by any signed-in player).
    match /players/{uid} {
      allow read: if signedIn();
      allow create, update: if isOwner(uid)
        && request.resource.data.nickname is string
        && request.resource.data.nickname.size() >= 1
        && request.resource.data.nickname.size() <= 16
        && request.resource.data.networth is number
        && request.resource.data.gems is number
        && request.resource.data.chestsOpened is number;
      allow delete: if isOwner(uid);
    }

    // Public Home Island listing for the Community Island (owner publishes; everyone reads).
    match /homes/{uid} {
      allow read: if signedIn();
      allow create, update: if isOwner(uid) && request.resource.data.uid == request.auth.uid
        && request.resource.data.nick is string && request.resource.data.nick.size() <= 24;
      allow delete: if isOwner(uid);
    }

    // Live presence: who is on which island and where (only written when needed).
    match /presence/{uid} {
      allow read: if signedIn();
      allow create, update: if isOwner(uid)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.isl is string
        && request.resource.data.nick is string
        && request.resource.data.nick.size() <= 16
        && request.resource.data.x is number
        && request.resource.data.y is number
        && request.resource.data.z is number;
      allow delete: if isOwner(uid);
    }

    // Generated islands: logged once on first visit, then only counters/visitors change.
    match /islands/{islandId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.name is string;
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['visits', 'lastVisit', 'discoverers', 'meta']);
      allow delete: if false;
    }

    // Beacons: owner manages their own; other players may only chip HP down (pistol = 1 per hit, batched).
    match /beacons/{beaconId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.owner == request.auth.uid
        && beaconId == request.auth.uid + '_' + string(request.resource.data.slot)
        && request.resource.data.hp == 100;
      allow update: if signedIn() && (
        resource.data.owner == request.auth.uid
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hp', 'lastHitBy'])
            && request.resource.data.hp >= 0
            && request.resource.data.hp < resource.data.hp
            && resource.data.hp - request.resource.data.hp <= 100
            && request.resource.data.lastHitBy is string
            && request.resource.data.lastHitBy.size() <= 16));
      allow delete: if signedIn() && resource.data.owner == request.auth.uid;
    }

    // PvP damage messages: attacker writes, victim reads and deletes.
    match /hits/{hitId} {
      allow create: if signedIn()
        && request.resource.data.from == request.auth.uid
        && request.resource.data.to is string
        && request.resource.data.dmg is number
        && request.resource.data.dmg >= 1 && request.resource.data.dmg <= 100;
      allow read, delete: if signedIn() && resource.data.to == request.auth.uid;
    }

    // Loot bags dropped on death: owner creates, anyone nearby can claim (delete).
    match /drops/{dropId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.owner == request.auth.uid
        && request.resource.data.isl is string;
      allow delete: if signedIn();
    }

    match /market/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.seller == request.auth.uid;
      allow update: if signedIn() && (resource.data.seller == request.auth.uid
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['qty'])
            && request.resource.data.qty < resource.data.qty));
      allow delete: if signedIn() && resource.data.seller == request.auth.uid;
    }
    match /sales/{id} {
      allow create: if signedIn() && request.resource.data.buyer == request.auth.uid;
      allow read, delete: if signedIn() && resource.data.seller == request.auth.uid;
    }
    match /trades/{id} {
      allow create: if signedIn() && request.auth.uid in request.resource.data.p;
      allow read, update, delete: if signedIn() && request.auth.uid in resource.data.p;
    }
    match /builds/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.owner == request.auth.uid;
      allow update: if signedIn() && (resource.data.owner == request.auth.uid
        || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lit'])
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hp'])
            && request.resource.data.hp is number
            && request.resource.data.hp >= 0
            && request.resource.data.hp < resource.data.hp));
      allow delete: if signedIn();
    }
    match /looted/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.by == request.auth.uid;
    }
    match /harv/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.by == request.auth.uid;
    }
    match /shopbuys/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.by == request.auth.uid;
    }
    // Shared kills so barbarians and animals die for everyone (one doc per enemy per respawn window).
    match /ekills/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.by == request.auth.uid
        && request.resource.data.isl is string && request.resource.data.g is string;
    }

    // Global world clock (night skips) shared by every player on every island.
    match /world/{id} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && request.resource.data.off is number
        && request.resource.data.ts is number;
      allow delete: if false;
    }
    // Global chat: anyone signed in reads; you can only post as yourself.
    match /chat/{id} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() >= 1 && request.resource.data.text.size() <= 200
        && request.resource.data.nick is string && request.resource.data.nick.size() <= 16
        && request.resource.data.t is number;
      allow update, delete: if false;
    }
    // Online roster + sleep votes (heartbeat every ~15s, one doc per player).
    match /online/{uid} {
      allow read: if signedIn();
      allow create, update: if isOwner(uid)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.t is number;
      allow delete: if isOwner(uid);
    }
  }
}
